PORT=5000
# MongoDB connection string. The database name is the part after the host (/api).
MONGODB_URI=mongodb://127.0.0.1:27017/api
# Address the website is opened from. Separate several with commas.
FRONTEND_URL=http://localhost:5173,https://parzivalapi.online
# Set to production when served over HTTPS (makes the session cookie Secure).
NODE_ENV=development

# Upstream URLs. The number is appended to the end, so end each with the parameter, e.g. ...&vno=
# An API can't be bought, and returns 503, until its URL is set.
VEHICLE_INFO_API1_URL=
DL_API_URL=
CHALLAN_API_URL=
FASTAG_API_URL=
HSRP_API_URL=
